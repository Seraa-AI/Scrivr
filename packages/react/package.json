{
  "name": "@scrivr/react",
  "version": "1.0.26",
  "description": "React bindings for the Scrivr canvas document editor",
  "license": "Apache-2.0",
  "author": "Seraa AI <hello@seraa.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Seraa-AI/Scrivr.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Seraa-AI/Scrivr#readme",
  "bugs": {
    "url": "https://github.com/Seraa-AI/Scrivr/issues"
  },
  "keywords": [
    "canvas",
    "editor",
    "react",
    "prosemirror",
    "document",
    "rich-text",
    "scrivr"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./track-changes": {
      "import": {
        "types": "./dist/track-changes.d.ts",
        "default": "./dist/track-changes.js"
      },
      "require": {
        "types": "./dist/track-changes.d.cts",
        "default": "./dist/track-changes.cjs"
      }
    },
    "./header-footer": {
      "import": {
        "types": "./dist/header-footer.d.ts",
        "default": "./dist/header-footer.js"
      },
      "require": {
        "types": "./dist/header-footer.d.cts",
        "default": "./dist/header-footer.cjs"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/ai.d.ts",
        "default": "./dist/ai.js"
      },
      "require": {
        "types": "./dist/ai.d.cts",
        "default": "./dist/ai.cjs"
      }
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json",
    "typecheck:consumer": "tsc -p type-tests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "peerDependencies": {
    "@scrivr/ai": "workspace:*",
    "@scrivr/core": "workspace:*",
    "@scrivr/plugins": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@scrivr/ai": {
      "optional": true
    },
    "@scrivr/plugins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@scrivr/ai": "workspace:*",
    "@scrivr/core": "workspace:*",
    "@scrivr/plugins": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
