{
  "name": "@scrivr/ai",
  "version": "1.0.17",
  "description": "AI layer for Scrivr — AI toolkit, suggestion overlay, and the semantic edit protocol",
  "license": "Apache-2.0",
  "author": "Seraa AI <hello@seraa.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Seraa-AI/Scrivr.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/Seraa-AI/Scrivr#readme",
  "bugs": {
    "url": "https://github.com/Seraa-AI/Scrivr/issues"
  },
  "keywords": [
    "ai",
    "editor",
    "prosemirror",
    "suggestions",
    "semantic",
    "scrivr"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@scrivr/core": "workspace:*",
    "@scrivr/plugins": "workspace:*"
  },
  "peerDependencies": {
    "prosemirror-model": ">=1.0.0",
    "prosemirror-state": ">=1.0.0"
  },
  "devDependencies": {
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
