{
  "name": "@scrivr/export-pdf",
  "version": "1.0.26",
  "description": "PDF export for Scrivr documents — same layout pipeline as the canvas renderer",
  "license": "Apache-2.0",
  "author": "Seraa AI <hello@seraa.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Seraa-AI/Scrivr.git",
    "directory": "packages/export-pdf"
  },
  "homepage": "https://github.com/Seraa-AI/Scrivr#readme",
  "keywords": [
    "pdf",
    "export",
    "canvas",
    "editor",
    "prosemirror",
    "scrivr"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fontkit": "2.0.4",
    "pdf-lib": "^1.17.1"
  },
  "peerDependencies": {
    "@scrivr/core": "workspace:*"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@napi-rs/canvas": "^1.2.0",
    "@scrivr/core": "workspace:*",
    "@scrivr/plugins": "workspace:*",
    "inter-ui": "4.1.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
