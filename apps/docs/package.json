{
  "name": "@scrivr/docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "config": {
    "DockerContainerRegistry": "registry.digitalocean.com/lansan-mycaretaker"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "deploy:production:build": "cd ../../ && docker build -f ./apps/docs/Dockerfile -t $npm_package_config_DockerContainerRegistry/scrivr-docs:production .",
    "deploy:production:push": "docker push $npm_package_config_DockerContainerRegistry/scrivr-docs:production"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.143",
    "@ai-sdk/react": "^3.0.336",
    "@anthropic-ai/sdk": "^0.80.0",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/source-serif-4": "^0.4.2",
    "@floating-ui/dom": "^1.8.0",
    "@scrivr/ai": "workspace:*",
    "@scrivr/core": "workspace:*",
    "@scrivr/docx": "workspace:*",
    "@scrivr/export-pdf": "workspace:*",
    "@scrivr/html": "workspace:*",
    "@scrivr/plugins": "workspace:*",
    "@scrivr/react": "workspace:*",
    "@tanstack/react-router": "1.168.3",
    "@tanstack/react-router-devtools": "1.166.11",
    "@tanstack/react-start": "1.167.6",
    "ai": "^6.0.333",
    "fumadocs-core": "16.7.6",
    "fumadocs-mdx": "14.2.11",
    "fumadocs-ui": "16.7.6",
    "inter-ui": "^4.1.1",
    "lucide-react": "^1.77.0",
    "next-themes": "0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "nitro": "3.0.260311-beta",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}